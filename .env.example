# Local Laya decisions (Apple Silicon, MLX). Fully offline once weights are downloaded (make weights).
DECISION_MODEL=laya
LAYA_MODEL=aac6fef/laya-typed-decisions-mlx

# Text model: one call per browser task turns the goal into field values and a finish condition.
# Default is local Ollama, so nothing leaves the machine. Pull one with: ollama pull qwen2.5
TEXT_MODEL_BASE_URL=http://localhost:11434/v1
TEXT_MODEL=qwen2.5:latest
TEXT_MODEL_REASONING=none
TEXT_MODEL_API_KEY=
# Hosted alternative:
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=inception/mercury-2.5
# TEXT_MODEL_API_KEY=sk-or-...

# Only for DECISION_MODEL=typesafe (the original hosted Jev policy)
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
